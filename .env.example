APP_ENV=development
PUBLIC_URL=http://localhost
HTTP_ADDR=:8080
FRONTEND_URL=http://localhost
DATABASE_URL=postgres://instantmeet:instantmeet@postgres:5432/instantmeet?sslmode=disable
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Local callback. Production Compose sets https://<APP_DOMAIN>/api/auth/google/callback.
GOOGLE_REDIRECT_URL=http://localhost/api/auth/google/callback
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_PUBLIC_URL=ws://localhost:7880
# Replace before any shared/public use; production rejects these defaults.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
# Set true only for local demo login without Google OAuth.
DEV_AUTH_ENABLED=false

