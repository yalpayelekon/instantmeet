APP_DOMAIN=toplanti.online
LIVEKIT_DOMAIN=livekit.toplanti.online
ACME_EMAIL=you@example.com

# Generate each secret independently; do not reuse values.
# Prefer: bash scripts/init-production-env.sh you@example.com
POSTGRES_PASSWORD=replace-with-a-long-random-password
JWT_SECRET=replace-with-at-least-32-random-characters
LIVEKIT_API_KEY=replace-with-a-random-key
LIVEKIT_API_SECRET=replace-with-a-long-random-secret

# Required for public sign-in. deploy.sh refuses to start without these.
# Google Cloud Console → Credentials → Create OAuth client (Web application)
# Authorized JavaScript origins: https://toplanti.online
# Authorized redirect URI: https://toplanti.online/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
